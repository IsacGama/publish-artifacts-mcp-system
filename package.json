{
  "name": "publish-artifacts-mcp",
  "version": "0.2.1",
  "description": "Safe HTML artifact publishing system, API-key controlled, exposed over MCP (stdio + Streamable HTTP)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "artifacts-server": "dist/index.js",
    "artifacts-mcp": "dist/mcp/stdio.js",
    "artifacts-create-key": "dist/cli/createKey.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "mcp:stdio": "tsx src/mcp/stdio.ts",
    "create-key": "tsx src/cli/createKey.ts",
    "test": "node --import tsx --test src/**/*.test.ts scripts/*.test.mjs",
    "test:watch": "node --import tsx --test --watch src/**/*.test.ts scripts/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publish:directory": "node scripts/publish-directory.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^11.7.0",
    "dompurify": "^3.4.18",
    "hono": "^4.13.19",
    "jsdom": "^25.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
