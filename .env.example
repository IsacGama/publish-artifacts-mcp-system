# --- Server ---
PORT=8788

# --- Origins (MUST be different hosts for safe isolation) ---
# Control plane: write API, admin UI, MCP-over-HTTP. API-key protected.
CONTROL_BASE_URL=http://localhost:8788
# Content plane: public serving of published artifacts. No credentials, no cookies.
# In production this MUST be a different domain, e.g. https://content.example.com
CONTENT_BASE_URL=http://content.localhost:8788

# --- Storage ---
DB_PATH=./data/artifacts.db

# --- Limits ---
# Max size of a single artifact's HTML, in bytes (default 2 MiB)
MAX_HTML_BYTES=2097152
# Publish/update rate limit per API key (requests per minute)
PUBLISH_RATE_PER_MIN=60

# --- Content Security Policy ---
# Default CSP mode applied to newly published artifacts: strict | relaxed
DEFAULT_CSP_MODE=strict

# --- Dev only ---
# Set to "1" to allow CONTROL and CONTENT to share a host (INSECURE, dev convenience).
ALLOW_SAME_ORIGIN=0
